# Optional. PageSpeed Insights / CrUX. Either name works. Without a key the
# hourly job still runs and records the real API result, including quota blocks.
PAGESPEED_API_KEY=
GOOGLE_API_KEY=

# Vercel Blob. Created when a Blob store is connected to this project.
# Private stores use OIDC + BLOB_STORE_ID. Public token stores use BLOB_READ_WRITE_TOKEN.
# Set BLOB_ACCESS=public only if the connected store is public.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_ACCESS=

# Required in production. Vercel sends it as Authorization: Bearer <CRON_SECRET>
# on the hourly cron. The measure route rejects unauthenticated production calls.
CRON_SECRET=

# Secondary "Update now" path. Leave blank until the Grok Bot webhook exists.
# Do not invent a URL. Both must be set or the button sends nothing.
# WEBHOOK_URL must be https. The route signs `${timestamp}.${rawBody}` with
# HMAC-SHA256 and sends X-Seoman-Signature: sha256=<hex>.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Optional share token for this internal board. Unset = no gate.
# This is not an account password and nothing else is collected.
SEOMAN_GATE=
